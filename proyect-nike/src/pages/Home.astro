---
import Layout from "../layouts/Layout.astro";
import nike from "../assets/nike.jpg";
---

<Layout>
  <section
    class="relative flex items-center justify-center h-screen overflow-hidden"
  >
    <!-- Imagen de fondo con filtro -->
    <div
      class="absolute inset-0 bg-center bg-cover"
      style={`background-image: url(${nike.src}); filter: brightness(0.6);`}
    >
    </div>

    <!-- Contenido centrado -->
    <div
      class="relative z-10 flex flex-col items-center text-center px-4 md:px-0 nike-container"
    >
      <h1
        class="text-white text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-nike"
      >
        Eleva tu Juego con Nike
      </h1>
      <p class="text-white text-lg md:text-xl mt-4 mb-8 max-w-xl text-nike2">
        Descubre la nueva colección y domina cada paso con estilo y comodidad.
      </p>
      <a
        href="/Merch"
        class="px-6 py-3 bg-white text-black font-semibold rounded-full shadow-lg transition-transform transform hover:scale-105 hover:shadow-2xl nike-buy"
      >
        Comprar Ahora
      </a>
    </div>
  </section>

  <script>
    import gsap from "gsap";

    gsap.from(".text-nike", {
      opacity: 0,
      y: 50,
      duration: 1,
    });

    gsap.from(".text-nike2", {
      opacity: 0,
      y: 50,
      duration: 1,
      delay: 0.5,
      stagger: 0.2,
    });

    gsap.from(".nike-buy", {
      opacity: 0,
      y: 50,
      duration: 1,
      delay: 1,
    });

    
  </script>
</Layout>
