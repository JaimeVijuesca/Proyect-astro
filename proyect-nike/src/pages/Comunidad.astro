---
import Layout from "../layouts/Layout.astro";
---

<script>
  let user = document.getElementById("users");

  fetch("https://randomuser.me/api/?results=6")
    .then((response) => response.json())
    .then((data) => {
      console.log(data);
      let users = data.results;

      for (let index = 0; index < users.length; index++) {
        user.innerHTML += `
          <div class="bg-white rounded-lg shadow-lg p-4 flex flex-col items-center text-center transition-transform transform hover:scale-105">
            <img class="rounded-full mb-4 w-24 h-24 object-cover" src="${users[index].picture.large}" alt="${users[index].name.first} ${users[index].name.last}">
            <h1 class="text-xl font-bold mb-1">${users[index].name.first} ${users[index].name.last}</h1>
            <p class="text-gray-600 text-sm">${users[index].email}</p>
          </div>
        `;
      }
    });
</script>

<Layout>
  <h1 class=" text-center p-10 text-xl font-bold  text-red-800">Clientes de Nike</h1>
  <div
    id="users"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 p-6 bg-gray-100"
  >
  </div>
</Layout>
