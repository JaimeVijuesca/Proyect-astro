---
import Layout from "../layouts/Layout.astro";
import { tickets } from "../data/tickets.js";
import EventIsla from "../pages/EventIsla.jsx";
---

<Layout>
  <main
    class="relative min-h-screen bg-cover bg-center text-white"
    style="background-image: url('https://petapixel.com/assets/uploads/2022/01/How-to-Photograph-Low-Light-Cityscapes-The-Best-Gear-and-Techniques.jpg');"
  >
    <h1
      class="flex font-black text-6xl tracking-[-0.05em] text-white uppercase justify-center p-4"
    >
      Events
    </h1>

    <div class="relative z-10">
      <EventIsla tickets={tickets} client:load />
    </div>
  </main>
</Layout>
