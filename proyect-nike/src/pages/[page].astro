---
export function getStaticPaths() {
  const pages = [
    "home",
    "events",
    "merch",
    "dashboard",
    "comunidad",
    "ubicacion",
    "about",
    "contacts",
  ];

  return pages.map((page) => ({
    params: { page },
  }));
}

const { page } = Astro.params;
---

<h1>Página: {page}</h1>
