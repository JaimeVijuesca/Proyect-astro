---
import Layout from "../layouts/Layout.astro";
---

<script>
  // Obtener elementos del formulario
  let name = document.getElementById("name");
  let email = document.getElementById("email");
  let subject = document.getElementById("subject");
  let message = document.getElementById("message");

  let form = document.getElementById("form");

  // Obtener el valor del boton
  const button = document.getElementById("button");
  button.addEventListener("click", () => {
    validateForm();
  });

  //Evento submit del formulario )

  //Validation de formulario
  const validateForm = () => {
    // Expresión regular simple para validar email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // Validar los datos
    if (
      name.value === "" ||
      email.value === "" ||
      subject.value === "" ||
      message.value === ""
    ) {
      alert("Por favor completa todos los campos");
    }
    if (!emailRegex.test(email.value)) {
      alert("Por favor ingresa un correo válido");
    } else {
      alert("Mensaje enviado");
      form.reset();
    }
  };
</script>

<Layout>
  <section
    class="min-h-screen w-full flex items-center justify-center bg-gray-50 px-4"
  >
    <div
      class="w-full max-w-lg bg-white shadow-xl rounded-2xl p-10 border border-gray-200"
    >
      <h2 class="text-3xl font-bold text-gray-800 text-center mb-8">
        Contacto
      </h2>

      <form class="flex flex-col gap-6" id="form">
        <div class="flex flex-col">
          <label class="text-gray-700 font-medium mb-1">Nombre</label>
          <input
            id="name"
            type="text"
            name="name"
            class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          />
        </div>

        <div class="flex flex-col">
          <label class="text-gray-700 font-medium mb-1">Email</label>
          <input
            id="email"
            type="email"
            name="email"
            class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          />
        </div>

        <div class="flex flex-col">
          <label class="text-gray-700 font-medium mb-1">Asunto</label>
          <input
            id="subject"
            type="text"
            name="subject"
            class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          />
        </div>

        <div class="flex flex-col">
          <label class="text-gray-700 font-medium mb-1">Mensaje</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="rounded-lg border border-gray-300 px-4 py-2 text-gray-700 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          ></textarea>
        </div>

        <button
          id="button"
          type="button"
          class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg hover:bg-blue-700 transition-colors"
        >
          Enviar
        </button>
      </form>
    </div>
  </section>
</Layout>
