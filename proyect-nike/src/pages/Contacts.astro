---
import Layout from "../layouts/Layout.astro";
---

<script>
  // Obtener elementos del formulario
  let name = document.getElementById("name");
  let email = document.getElementById("email");
  let subject = document.getElementById("subject");
  let message = document.getElementById("message");

  let form = document.getElementById("form");

  // Obtener el valor del boton
  const button = document.getElementById("button");
  button.addEventListener("click", () => {
    validateForm();
  });

  //Evento submit del formulario )

  //Validation de formulario
  const validateForm = () => {
    // Expresión regular simple para validar email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // Validar los datos
    if (
      name.value === "" ||
      email.value === "" ||
      subject.value === "" ||
      message.value === ""
    ) {
      alert("Por favor completa todos los campos");
    }
    if (!emailRegex.test(email.value)) {
      alert("Por favor ingresa un correo válido");
    } else {
      alert("Mensaje enviado");
      form.reset();
    }
  };
</script>

<Layout>
  <section
  class="min-h-screen w-full flex items-center justify-center bg-neutral-950 px-4"
>
  <div
    class="w-full max-w-lg bg-neutral-900 rounded-2xl p-10 border border-neutral-800"
  >
    <h1
      class="flex font-black text-6xl tracking-[-0.05em] text-white uppercase justify-center mb-8"
    >
      Contacto
    </h1>

    <form class="flex flex-col gap-6" id="form">
      <div class="flex flex-col gap-1">
        <label class="text-sm uppercase tracking-wide text-neutral-400">
          Nombre
        </label>
        <input
          id="name"
          type="text"
          name="name"
          class="bg-transparent border-b border-neutral-600 px-1 py-2 text-white focus:border-white focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm uppercase tracking-wide text-neutral-400">
          Email
        </label>
        <input
          id="email"
          type="email"
          name="email"
          class="bg-transparent border-b border-neutral-600 px-1 py-2 text-white focus:border-white focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm uppercase tracking-wide text-neutral-400">
          Asunto
        </label>
        <input
          id="subject"
          type="text"
          name="subject"
          class="bg-transparent border-b border-neutral-600 px-1 py-2 text-white focus:border-white focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label class="text-sm uppercase tracking-wide text-neutral-400">
          Mensaje
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="bg-transparent border-b border-neutral-600 px-1 py-2 text-white focus:border-white focus:outline-none resize-none"
        ></textarea>
      </div>

      <button
        id="button"
        type="button"
        class="mt-8 w-full bg-white text-black font-bold py-4 uppercase tracking-wide hover:bg-neutral-200 transition-colors"
      >
        Enviar mensaje
      </button>
    </form>
  </div>
</section>

</Layout>
